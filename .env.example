# ── API Keys ─────────────────────────────────────────────
# ElevenLabs — TTS and sound effects generation
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Anthropic — Claude script adaptation
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Reddit — fetching nosleep stories (create app at https://www.reddit.com/prefs/apps)
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here

# ── Authentication ───────────────────────────────────────
# Secret key for signing JWT tokens (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=change_me_to_a_random_secret
