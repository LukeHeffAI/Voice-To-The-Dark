# ── API Keys ─────────────────────────────────────────────
# ElevenLabs — TTS and sound effects generation
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Anthropic — Claude script adaptation
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Authentication ───────────────────────────────────────
# Secret key for signing JWT tokens (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=change_me_to_a_random_secret

# ── Django ──────────────────────────────────────────────
DJANGO_ENV=production
# ALLOWED_HOSTS=localhost,127.0.0.1
# CORS_ALLOWED_ORIGINS=http://localhost:8000

# ── Cloudflare Tunnel (optional) ─────────────────────────
# Enables remote access without port forwarding.
# See SETUP_GUIDE.md for instructions. Leave commented out to skip.
# CLOUDFLARE_TUNNEL_TOKEN=your_tunnel_token_here
