# ── API Keys ─────────────────────────────────────────────
# ElevenLabs — TTS and sound effects generation
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Anthropic — Claude script adaptation
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Authentication ───────────────────────────────────────
# Secret key for signing JWT tokens (generate with: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET_KEY=change_me_to_a_random_secret

# ── Database ────────────────────────────────────────────
# SQLite database path (default works with Docker volumes)
# DATABASE_URL=sqlite:///./data/db/horror_narrator.db
